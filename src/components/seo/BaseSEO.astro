---
import { SITE_TITLE, SITE_DESCRIPTION, LOCALE_MAP } from '@/consts'
import { BUSINESS_DATA } from '@/data/site-config'
import { getTranslations, getLocalizedPath } from '@/lib/i18n/utils'
import { stripMarkdown } from '@/lib/markdown'

const {
	currentPage,
	lang = 'es',
	title,
	schemaName,
	description,
	baseDescription,
	keywords,
	baseKeywords,
	jsonType = 'Organization',
	extraJson = {},
	ogImage,
	useTagLine = true,
	noIndex = false,
} = Astro.props

const t = getTranslations(lang)

// Title resolution chain: prop → i18n → SITE_TITLE → default.
const i18nTitle = currentPage ? t(`pages.${currentPage}.title`) : undefined
const resolvedTitle =
	title ?? i18nTitle ?? SITE_TITLE

// Description resolution chain: prop → baseDescription → i18n → SITE_DESCRIPTION.
const i18nDesc = currentPage ? t(`pages.${currentPage}.description`) : undefined
const resolvedDescription = stripMarkdown(
	description ?? baseDescription ?? i18nDesc ?? SITE_DESCRIPTION,
)

const resolvedKeywords =
	keywords ?? baseKeywords ?? (currentPage ? t(`pages.${currentPage}.keywords`) : undefined)

// Tagline: " | Business Name" for non-home pages.
const finalTitle =
	useTagLine && resolvedTitle !== BUSINESS_DATA.name && currentPage !== 'home'
		? `${resolvedTitle} | ${BUSINESS_DATA.name}`
		: resolvedTitle

// Canonical URL. The public site is Spanish-only, so hreflang alternates
// would be misleading and are intentionally omitted.
const canonicalPath = currentPage
	? getLocalizedPath(currentPage)
	: Astro.url.pathname
const canonicalUrl = `${BUSINESS_DATA.url}${canonicalPath}`

// JSON-LD (polymorphic).
const isProd = import.meta.env.PROD
const resolvedOgImage = ogImage ?? BUSINESS_DATA.ogImage
const ogUrl = resolvedOgImage.startsWith('http')
	? resolvedOgImage
	: `${BUSINESS_DATA.url}${resolvedOgImage}`

const baseSchema = {
	'@context': 'https://schema.org',
	'@type': jsonType,
	'@id': `${BUSINESS_DATA.url}#${jsonType.toLowerCase()}`,
	name: schemaName ?? finalTitle,
	description: resolvedDescription,
	url: canonicalUrl,
	image: ogUrl,
	inLanguage: lang,
}

const isLocalBusiness = jsonType === 'LocalBusiness' || jsonType === 'TravelAgency'
const sameAs = BUSINESS_DATA.socialLinks.filter(Boolean)
const organizationSchema = jsonType === 'Organization'
	? {
		logo: `${BUSINESS_DATA.url}${BUSINESS_DATA.logo}`,
		...(BUSINESS_DATA.contact.phone && {
			contactPoint: {
				'@type': 'ContactPoint',
				telephone: BUSINESS_DATA.contact.phone,
				contactType: 'patient support',
				availableLanguage: 'Spanish',
			},
		}),
		...(sameAs.length && { sameAs }),
	}
	: {}
const localBusinessSchema = isLocalBusiness
	? {
		logo: `${BUSINESS_DATA.url}${BUSINESS_DATA.logo}`,
		...(BUSINESS_DATA.contact.phone && { telephone: BUSINESS_DATA.contact.phone }),
		...(BUSINESS_DATA.contact.address && { address: BUSINESS_DATA.contact.address }),
		...(BUSINESS_DATA.contact.geo && { geo: BUSINESS_DATA.contact.geo }),
		...(BUSINESS_DATA.hours.length && { openingHoursSpecification: BUSINESS_DATA.hours }),
		...(sameAs.length && { sameAs }),
	}
	: {}

const jsonLd = { ...baseSchema, ...organizationSchema, ...localBusinessSchema, ...extraJson }

const ogTypeMap = {
	Organization: 'website',
	LocalBusiness: 'website',
	TravelAgency: 'website',
	Blog: 'website',
	BlogPosting: 'article',
	Service: 'website',
}
const ogType = ogTypeMap[jsonType] || 'website'
---

<title>{finalTitle}</title>
<meta name="description" content={resolvedDescription} />
{resolvedKeywords && <meta name="keywords" content={resolvedKeywords} />}
<meta name="author" content="Dr. Frank Arguello" />
<meta property="og:type" content={ogType} />
<meta property="og:locale" content={LOCALE_MAP[lang]} />
<meta property="og:site_name" content={BUSINESS_DATA.name} />
<meta property="og:title" content={finalTitle} />
<meta property="og:description" content={resolvedDescription} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={ogUrl} />
<meta property="og:image:secure_url" content={ogUrl} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={finalTitle} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={finalTitle} />
<meta name="twitter:description" content={resolvedDescription} />
<meta name="twitter:image" content={ogUrl} />
<meta name="twitter:image:alt" content={finalTitle} />
<link rel="canonical" href={canonicalUrl} />
{!isProd && <meta name="robots" content="noindex, nofollow" />}
{noIndex && <meta name="robots" content="noindex" />}
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
