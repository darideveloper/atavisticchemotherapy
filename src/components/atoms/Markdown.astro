---
import { renderMarkdown } from '@/lib/markdown'

export interface Props {
	content?: string | null
	class?: string
	variant?: 'default' | 'compact' | 'on-dark'
	dropcap?: boolean
	copyLabel?: string
	copiedLabel?: string
}

const {
	content,
	class: className,
	variant = 'default',
	dropcap = false,
	copyLabel,
	copiedLabel,
} = Astro.props
const html = renderMarkdown(content ?? '', { copyLabel, copiedLabel })
// Sizing/width/color stay with the caller via `class` — only `prose-*`
// element styles are baked in here.
const prose =
	'prose-headings:font-serif prose-p:leading-[1.85] prose-p:mb-6 prose-a:underline prose-a:underline-offset-4 prose-strong:font-semibold prose-em:italic prose-blockquote:border-l-2 prose-blockquote:pl-5 prose-blockquote:italic prose-img:my-10 prose-img:mx-auto prose-img:block prose-code:text-[12px] prose-code:px-1.5 prose-code:py-0.5 prose-pre:p-0 prose-pre:overflow-hidden prose-ul:list-disc prose-ul:pl-6 prose-ul:my-6 prose-ol:list-decimal prose-ol:pl-6 prose-ol:my-6 prose-li:my-2 prose-table:w-full prose-table:border-collapse prose-table:my-8 prose-th:text-left prose-th:px-4 prose-th:py-3 prose-td:px-4 prose-td:py-3 prose-td:align-top'
---

<div
	class:list={['markdown-prose', prose, variant !== 'default' && `markdown-prose--${variant}`, dropcap && 'markdown-prose--dropcap', className]}
	set:html={html}
/>

<script>
	import { attachCodeCopy } from '@/lib/code-copy'
	attachCodeCopy()
	document.addEventListener('astro:page-load', () => attachCodeCopy())
</script>