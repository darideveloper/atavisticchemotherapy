---
import Image from '@/components/atoms/Image.astro'
import { CLINICAL_CASES } from '@/data/clinical-cases'
---

<section class="flow-clinical bg-[#f8f5f8] py-20 lg:py-24" id="ejemplos" aria-labelledby="ejemplos-heading" style="order:4">
	<div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
		<div class="mx-auto max-w-2xl text-center sm:max-w-3xl lg:max-w-4xl">
			<h2 id="ejemplos-heading" class="text-3xl font-extrabold uppercase tracking-tight text-slate-900 sm:text-4xl">Ejemplos de casos clínicos tratados con quimioterapia atavística</h2>
			<p class="mt-3 text-sm leading-relaxed text-slate-600 sm:text-base">
				Estos son ejemplos del notable efecto anticanceroso y selectivo de la quimioterapia atavística en pacientes con cáncer avanzado, quienes habían sido considerados terminales o desahuciados por hospitales en Canadá, Estados Unidos o México. Las representaciones visuales y las descripciones clínicas que se presentan a continuación ilustran la secuencia de eventos que ocurren antes, durante y después del tratamiento con quimioterapia atavística.
			</p>
		</div>

		<div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{CLINICAL_CASES.map((clinicalCase) => (
				<article class="flex h-full flex-col overflow-hidden rounded-2xl bg-white shadow-[0_18px_40px_-28px_rgba(76,17,57,0.45)] transition duration-300 hover:-translate-y-1">
					<div class:list={['grid h-72 shrink-0 gap-1 bg-rose-50 p-3', clinicalCase.images.length > 1 ? 'grid-cols-2' : 'grid-cols-1']}>
						{clinicalCase.images.map((image) => (
							<figure class="min-h-0 overflow-hidden rounded-lg bg-[#f8f5f8]">
								<Image
									src={image.src}
									alt={image.alt}
									class="block h-full w-full object-contain cursor-zoom-in"
									widths={[400, 800]}
									sizes={clinicalCase.images.length > 1 ? '(max-width: 639px) calc(50vw - 2rem), (max-width: 1023px) calc(25vw - 2rem), 184px' : '(max-width: 639px) calc(100vw - 3.5rem), (max-width: 1023px) calc(50vw - 3rem), 384px'}
									lightbox
								/>
							</figure>
						))}
					</div>

					<div class="flex flex-1 flex-col p-6">
						<h3 class="text-lg font-extrabold leading-snug tracking-tight text-[#5c1642]">{clinicalCase.title}</h3>
						<p class="mt-3 text-sm font-semibold leading-relaxed text-slate-600">{clinicalCase.summary}</p>
						<details class="case-details mt-5">
							<summary><span class="flex-1">Leer el caso completo</span></summary>
							<div class="acc-body text-sm leading-relaxed text-slate-600">
								<p>{clinicalCase.narrative}</p>
							</div>
						</details>
					</div>
				</article>
			))}
		</div>
	</div>
</section>

<style>
	.case-details {
		border: 1px solid #f3d9ea;
		border-radius: 1rem;
		background: #ffffff;
		overflow: hidden;
	}

	.case-details > summary {
		display: flex;
		align-items: center;
		cursor: pointer;
		list-style: none;
		padding: 0.75rem 1rem;
		color: #9a3676;
		font-weight: 700;
		user-select: none;
		transition: background-color 150ms ease, color 150ms ease;
	}

	.case-details > summary::-webkit-details-marker {
		display: none;
	}

	.case-details > summary::after {
		content: '+';
		flex: none;
		font-size: 1.25rem;
		font-weight: 800;
		line-height: 1;
	}

	.case-details[open] > summary::after {
		content: '\2013';
	}

	.case-details > summary:hover {
		background: #fdf2f8;
		color: #641b4e;
	}

	.case-details > summary:focus-visible {
		outline: 2px solid #c24694;
		outline-offset: -2px;
	}
</style>
