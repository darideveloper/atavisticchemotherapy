---
import { getLocalizedPath, getTranslations } from '@/lib/i18n/utils'

export interface Props {
	lang?: string
}

const { lang = 'en' } = Astro.props
const t = getTranslations(lang)
---

<footer class="flow-footer border-t border-rose-100 bg-white py-8" aria-label="Pie de página" style="order:10">
<div class="mx-auto flex max-w-6xl flex-col items-center gap-3 px-4 text-center text-xs text-slate-500 sm:px-6 lg:px-8">
<p>© {new Date().getFullYear()} Atavistic Chemotherapy Clinical Trial™. Todos los derechos reservados.</p>
<nav class="flex flex-wrap justify-center gap-x-5 gap-y-2" aria-label="Enlaces legales">
<a class="underline underline-offset-2 transition hover:text-[#9a3676]" href={getLocalizedPath('privacy', lang)}>{t('global.footer.privacy')}</a>
<a class="underline underline-offset-2 transition hover:text-[#9a3676]" href={getLocalizedPath('terms', lang)}>{t('global.footer.terms')}</a>
<a class="underline underline-offset-2 transition hover:text-[#9a3676]" href={getLocalizedPath('cookies', lang)}>{t('global.footer.cookies')}</a>
<a class="underline underline-offset-2 transition hover:text-[#9a3676]" href={getLocalizedPath('medical-disclaimer', lang)}>{t('global.footer.medicalDisclaimer')}</a>
<a class="underline underline-offset-2 transition hover:text-[#9a3676]" href={getLocalizedPath('legal-notice', lang)}>{t('global.footer.legalNotice')}</a>
</nav>
</div>
</footer>
