---
import Layout from '@/layouts/Layout.astro'
import PageSEO from '@/components/seo/PageSEO.astro'
---

<Layout>
	<PageSEO
		slot="seo"
		title="Page not found"
		description="The requested page does not exist."
		jsonType="WebPage"
		noIndex
	/>
