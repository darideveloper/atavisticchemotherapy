---
import Layout from '@/layouts/Layout.astro'
import PageSEO from '@/components/seo/PageSEO.astro'
---

<Layout lang="es">
	<PageSEO
		slot="seo"
		title="Página no encontrada"
		description="La página solicitada no existe o pudo haber cambiado de ubicación."
		jsonType="WebPage"
		noIndex
	/>

	<section class="not-found">
		<div class="not-found__grid" aria-hidden="true"></div>
		<div class="not-found__orb not-found__orb--top" aria-hidden="true"></div>
		<div class="not-found__orb not-found__orb--bottom" aria-hidden="true"></div>

		<div class="not-found__content">
			<div class="not-found__copy">
				<p class="not-found__eyebrow">Error 404</p>
				<h1>Esta página<br />no está aquí.</h1>
				<p class="not-found__message">La dirección podría haber cambiado o el enlace ya no estar disponible. Vuelve al inicio para continuar explorando.</p>
				<a class="not-found__cta" href="/">
					<svg aria-hidden="true" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
						<path d="M11.5 4.5 6 10l5.5 5.5M6.5 10h8" stroke-linecap="round" stroke-linejoin="round" />
					</svg>
					Volver al inicio
				</a>
			</div>

			<aside class="not-found__card" aria-label="Atavistic Chemotherapy">
				<img class="not-found__mark" src="/apple-touch-icon.png?v=2" alt="" width="88" height="88" />
				<p class="not-found__number" aria-hidden="true">404</p>
				<p class="not-found__brand">Atavistic Chemotherapy</p>
				<div class="not-found__rule" aria-hidden="true"></div>
				<p class="not-found__card-copy">Una ruta no encontrada no tiene por qué detener tu búsqueda de información.</p>
			</aside>
		</div>
	</section>
</Layout>

<style>
	.not-found {
		position: relative;
		isolation: isolate;
		display: grid;
		min-height: calc(100svh - 9.5rem);
		place-items: center;
		overflow: hidden;
		padding: 4.25rem 1.5rem;
		background: linear-gradient(135deg, #742058 0%, #581642 50%, #460f33 100%);
	}

	.not-found__grid {
		position: absolute;
		inset: 0;
		z-index: -3;
		opacity: 0.18;
		background-image: linear-gradient(rgba(255, 255, 255, 0.2) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, 0.2) 1px, transparent 1px);
		background-size: 3.5rem 3.5rem;
	}

	.not-found__orb {
		position: absolute;
		z-index: -2;
		border-radius: 50%;
		background: rgba(201, 113, 170, 0.18);
		filter: blur(2px);
	}

	.not-found__orb--top {
		top: -15rem;
		right: -8rem;
		width: 34rem;
		height: 34rem;
	}

	.not-found__orb--bottom {
		bottom: -17rem;
		left: -12rem;
		width: 38rem;
		height: 38rem;
	}

	.not-found__content {
		display: grid;
		width: min(100%, 73rem);
		grid-template-columns: minmax(0, 1fr) minmax(21rem, 29rem);
		align-items: center;
		gap: clamp(3rem, 10vw, 10rem);
	}

	.not-found__copy {
		max-width: 34rem;
		color: #fff;
	}

	.not-found__eyebrow,
	.not-found__brand {
		margin: 0;
		font-size: 0.75rem;
		font-weight: 800;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	.not-found__eyebrow {
		color: #fce7f3;
	}

	.not-found h1 {
		margin: 1.5rem 0 0;
		font-family: 'Playfair Display', Georgia, serif;
		font-size: clamp(3.25rem, 6vw, 5.6rem);
		font-weight: 800;
		line-height: 0.9;
		letter-spacing: -0.04em;
		text-wrap: balance;
	}

	.not-found__message {
		max-width: 32rem;
		margin: 2rem 0 0;
		font-size: 1rem;
		line-height: 1.7;
		color: #fde7f2;
	}

	.not-found__cta {
		display: inline-flex;
		align-items: center;
		gap: 0.625rem;
		margin-top: 2.25rem;
		padding: 0.875rem 1.7rem;
		border-radius: 9999px;
		background: #fff;
		box-shadow: 0 12px 25px -10px rgba(29, 4, 21, 0.6);
		font-size: 0.75rem;
		font-weight: 800;
		letter-spacing: 0.02em;
		color: #581642;
		text-decoration: none;
		transition: transform 160ms ease-out, box-shadow 160ms ease-out, background-color 160ms ease-out;
	}

	.not-found__cta:hover {
		background: #fce7f3;
		transform: translateY(-2px);
		box-shadow: 0 16px 28px -10px rgba(29, 4, 21, 0.7);
	}

	.not-found__cta:focus-visible {
		outline: 2px solid #fff;
		outline-offset: 4px;
	}

	.not-found__card {
		display: flex;
		min-height: 29rem;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 3rem;
		border: 1px solid rgba(255, 255, 255, 0.2);
		border-radius: 2rem;
		background: rgba(88, 22, 66, 0.76);
		box-shadow: 0 24px 48px -28px rgba(25, 3, 18, 0.72);
		color: #fff;
		text-align: center;
		backdrop-filter: blur(12px);
	}

	.not-found__mark {
		display: block;
		width: 5.5rem;
		height: 5.5rem;
		border-radius: 50%;
		box-shadow: 0 10px 24px -12px rgba(0, 0, 0, 0.85);
	}

	.not-found__number {
		margin: 2.25rem 0 0;
		font-size: clamp(4.5rem, 7vw, 6rem);
		font-weight: 800;
		line-height: 0.8;
		letter-spacing: -0.05em;
	}

	.not-found__brand {
		margin-top: 2rem;
		color: #fce7f3;
	}

	.not-found__rule {
		width: 4rem;
		height: 1px;
		margin-top: 1.5rem;
		background: rgba(255, 255, 255, 0.5);
	}

	.not-found__card-copy {
		max-width: 21rem;
		margin: 1.5rem 0 0;
		font-size: 0.875rem;
		line-height: 1.7;
		color: #fce7f3;
	}

	@media (max-width: 48rem) {
		.not-found {
			padding: 4rem 1.25rem;
		}

		.not-found__content {
			grid-template-columns: 1fr;
			gap: 3.5rem;
		}

		.not-found__copy {
			max-width: 36rem;
			margin: 0 auto;
			text-align: center;
		}

		.not-found__message {
			margin-right: auto;
			margin-left: auto;
		}

		.not-found__card {
			width: min(100%, 29rem);
			min-height: 25rem;
			margin: 0 auto;
		}
	}

	@media (max-width: 30rem) {
		.not-found h1 {
			font-size: 3.25rem;
		}

		.not-found__card {
			min-height: 22rem;
			padding: 2.25rem 1.5rem;
		}
	}
</style>
