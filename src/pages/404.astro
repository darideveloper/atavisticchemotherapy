---
import Layout from '@/layouts/Layout.astro'
import PageSEO from '@/components/seo/PageSEO.astro'
---

<Layout lang="es">
	<PageSEO
		slot="seo"
		title="Página no encontrada"
		description="La página solicitada no existe o pudo haber cambiado de ubicación."
		jsonType="WebPage"
		noIndex
	/>

	<section class="not-found">
		<div class="not-found__accent" aria-hidden="true"></div>
		<div class="not-found__content">
			<img class="not-found__mark" src="/favicon.svg?v=3" alt="" width="96" height="96" />
			<p class="not-found__code" aria-hidden="true">404</p>
			<h1>No encontramos esa página.</h1>
			<p class="not-found__message">La dirección podría haber cambiado o el enlace ya no estar disponible. Vuelve al inicio para continuar explorando.</p>
			<a class="not-found__cta" href="/">
				<svg aria-hidden="true" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
					<path d="M11.5 4.5 6 10l5.5 5.5M6.5 10h8" stroke-linecap="round" stroke-linejoin="round" />
				</svg>
				Volver al inicio
			</a>
		</div>
	</section>
</Layout>

<style>
	.not-found {
		position: relative;
		display: grid;
		min-height: calc(100svh - 9.5rem);
		place-items: center;
		overflow: hidden;
		padding: 5rem 1.5rem;
		background: #fcfafc;
	}

	.not-found__accent {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 0.5rem;
		background: linear-gradient(90deg, #742058, #9a3676, #581642);
	}

	.not-found__content {
		display: flex;
		width: min(100%, 42rem);
		flex-direction: column;
		align-items: center;
		text-align: center;
	}

	.not-found__mark {
		display: block;
		width: 6rem;
		height: 6rem;
		border-radius: 9999px;
		box-shadow: 0 14px 30px -18px rgba(76, 17, 57, 0.48);
	}

	.not-found__code {
		margin: 2rem 0 0;
		font-size: 0.75rem;
		font-weight: 800;
		letter-spacing: 0.16em;
		color: #9a3676;
	}

	.not-found h1 {
		max-width: 12ch;
		margin: 0.75rem 0 0;
		font-size: clamp(1.875rem, 4vw, 3rem);
		font-weight: 800;
		line-height: 1.08;
		letter-spacing: -0.03em;
		color: #4c1139;
		text-wrap: balance;
	}

	.not-found__message {
		max-width: 37rem;
		margin: 1.5rem 0 0;
		font-size: 1rem;
		line-height: 1.7;
		color: #64748b;
	}

	.not-found__cta {
		display: inline-flex;
		align-items: center;
		gap: 0.625rem;
		margin-top: 2rem;
		padding: 0.875rem 1.75rem;
		border-radius: 9999px;
		background: linear-gradient(90deg, #9b3174, #c24694);
		box-shadow: 0 12px 25px -10px rgba(154, 54, 118, 0.45);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		color: #fff;
		text-decoration: none;
		text-transform: uppercase;
		transition: transform 160ms ease-out, box-shadow 160ms ease-out, filter 160ms ease-out;
	}

	.not-found__cta:hover {
		filter: brightness(0.94);
		transform: translateY(-2px);
		box-shadow: 0 16px 28px -10px rgba(154, 54, 118, 0.5);
	}

	.not-found__cta:focus-visible {
		outline: 2px solid #9a3676;
		outline-offset: 4px;
	}

	@media (max-width: 40rem) {
		.not-found {
			padding: 4rem 1.25rem;
		}

		.not-found__mark {
			width: 5rem;
			height: 5rem;
		}
	}
</style>
