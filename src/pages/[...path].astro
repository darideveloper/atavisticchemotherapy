---
import { getCollection } from 'astro:content'
import LegalPage from '@/components/pages/legal/LegalPage.astro'
import { routes, type PageKey } from '@/lib/i18n/routes'

export async function getStaticPaths() {
	// NOTE: keep all logic inside this function — Astro executes it from a
	// compiled chunk where frontmatter top-level bindings are not in scope.
	const legalKeys = (Object.keys(routes) as PageKey[]).filter((key) => key !== 'home')

	return legalKeys.map((pageKey) => ({
		params: { path: routes[pageKey] },
		props: { pageKey },
	}))
}

const { pageKey } = Astro.props as { pageKey: PageKey }
const lang = 'es'

const entries = await getCollection('legal')
const entry = entries.find((candidate) => candidate.id === `${pageKey}.${lang}`)

if (!entry) throw new Error(`Missing legal markdown file for ${pageKey}.${lang}`)
---

<LegalPage
	title={entry.data.title}
	description={entry.data.description}
	updated={entry.data.updated}
	body={entry.body}
	lang={lang}
	pageKey={pageKey}
/>
