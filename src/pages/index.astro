<script is:inline>
  (() => {
    const details = document.querySelector('#referencias details')

    const openReference = (hash) => {
      if (!details || !hash || !hash.startsWith('#reference-')) return

      const target = document.querySelector(hash)
      if (!target || !target.closest('#referencias')) return

      details.open = true
      requestAnimationFrame(() => {
        target.scrollIntoView({ behavior: 'smooth', block: 'center' })
      })
    }

    document.addEventListener('click', (event) => {
      const link = event.target instanceof Element
        ? event.target.closest('a.reference-note')
        : null

      if (link) openReference(link.hash)
    })

    window.addEventListener('hashchange', () => openReference(window.location.hash))
    openReference(window.location.hash)
  })()
</script>

