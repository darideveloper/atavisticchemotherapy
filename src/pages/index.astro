---
import '@/styles/global.css';
import { BUSINESS_DATA } from '@/data/site-config';
import { PATIENT_TESTIMONIALS } from '@/data/testimonials';
import Image from '@/components/atoms/Image.astro';
import ClinicalCaseExamples from '@/components/organisms/ClinicalCaseExamples.astro';
import TestimonialSlider from '@/components/organisms/TestimonialSlider';
import { IMAGE_SLOTS, slideSet } from '@/lib/images';
import eyeEnucleation from '@/assets/content/Eye-Enucleation.jpg';
import mastectomy from '@/assets/content/Mastectomy.jpg';
import brainMetastases from '@/assets/content/tumores-metastasicos-cerebro.png';
import lungMetastases from '@/assets/content/tumores-metastasicos-pulmones.png';
import luca from '@/assets/content/luca-ancestro-comun.png';
import atavisticMetamorphosis from '@/assets/content/metamorfosis-atavica.png';
import atavism from '@/assets/content/3era.webp';
import organisms from '@/assets/content/4ta.webp';
import normalCell from '@/assets/content/Mother.png';
import treatedPatients from '@/assets/content/alice-th.jpg';
import frankArguelloPatient from '@/assets/content/frank-arguello-paciente-hospital.png';
import headshot from '@/assets/content/headshot.png';
import logoWhite from '@/assets/content/logo-white.png';

const optimizedTestimonials = await Promise.all(
  PATIENT_TESTIMONIALS.map(async (testimonial) => ({
    ...testimonial,
    images: await Promise.all(
      testimonial.images.map(async (image) => ({
        src: image.src.src,
        alt: image.alt,
        set: await slideSet(image.src, IMAGE_SLOTS.testimonial),
      })),
    ),
  })),
);

const REFERENCES = [
  'Theobald DL. A formal test of the theory of universal common ancestry. Nature. 2010 May 13;465(7295):219-22. doi: 10.1038/nature09014. PMID: 20463738.',
  'Gómez-Márquez J. What are the principles that govern life? Commun Integr Biol. 2020 Aug 10;13(1):97-107. doi: 10.1080/19420889.2020.1803591. PMID: 33014262; PMCID: PMC7518457.',
  'Adashek, J.J., Kato, S., Lippman, S.M. et al. The paradox of cancer genes in non-malignant conditions: implications for precision medicine. Genome Med 12, 16 (2020). https://doi.org/10.1186/s13073-020-0714-y',
  'Kennedy SR, Zhang Y, Risques RA. Cancer-Associated Mutations but No Cancer: Insights into the Early Steps of Carcinogenesis and Implications for Early Cancer Detection. Trends Cancer. 2019 Sep;5(9):531-540. doi: 10.1016/j.trecan.2019.07.007. Epub 2019 Aug 22. PMID: 31474358; PMCID: PMC8765002.',
  'Middleton JD, Stover DG, Hai T. Chemotherapy-exacerbated breast cancer metastasis: a paradox explainable by dysregulated adaptive-response. Int J Mol Sci. 2018 Oct 26;19(11):3333. doi: 10.3390/ijms19113333. PMID: 30373101; PMCID: PMC6274941.',
  'D’Alterio C, Scala S, Sozzi G, Roz L, Bertolini G. Paradoxical effects of chemotherapy on tumor relapse and metastasis promotion. Semin Cancer Biol. 2020 Feb;60:351-361. doi: 10.1016/j.semcancer.2019.08.019. Epub 2019 Aug 24. PMID: 31454672.',
  'Wang ZF, Ma CH, Maswikiti EP, Han QY, He LJ, Liu B, Han ZJ, Chen H. The Black Hole of Immune Checkpoint Blocking Therapy for Gastric Cancer: Hyperprogressive Disease. Cancer Sci. 2025 Oct;116(10):2630-2639. doi: 10.1111/cas.70143. Epub 2025 Jul 23. PMID: 40702846; PMCID: PMC12485826.',
  'Saâda-Bouzid E, Defaucheux C, Karabajakian A, Coloma VP, Servois V, Paoletti X, Even C, Fayette J, Guigay J, Loirat D, Peyrade F, Alt M, Gal J, Le Tourneau C. Hyperprogression during anti-PD-1/PD-L1 therapy in patients with recurrent and/or metastatic head and neck squamous cell carcinoma. Ann Oncol. 2017 Jul 1;28(7):1605-1611. doi: 10.1093/annonc/mdx178. PMID: 28419181.',
  'Global Burden of Disease 2019 Cancer Collaboration, Kocarnik JM, Compton K, et al. Cancer Incidence, Mortality, Years of Life Lost, Years Lived With Disability, and Disability-Adjusted Life Years for 29 Cancer Groups From 2010 to 2019: A Systematic Analysis for the Global Burden of Disease Study 2019. JAMA Oncol. 2022;8(3):420-444. doi:10.1001/jamaoncol.2021.6987',
  'Siegel RL, Giaquinto AN, Jemal A. Cancer statistics, 2024. CA Cancer J Clin. 2024 Jan-Feb;74(1):12-49. doi: 10.3322/caac.21820. Epub 2024 Jan 17. Erratum in: CA Cancer J Clin. 2024 Mar-Apr;74(2):203. PMID: 38230766',
  'Twombly R. Cancer surpasses heart disease as leading cause of death for all but the very elderly. J Natl Cancer Inst. 2005;97(5):330-331. doi:10.1093/jnci/97.5.330',
  'Harding MC, Sloan CD, Merrill RM, Harding TM, Thacker BJ, Thacker EL. Transitions From Heart Disease to Cancer as the Leading Cause of Death in US States, 1999-2016. Prev Chronic Dis. 2018;15:E158. Published 2018 Dec 13. doi:10.5888/pcd15.180151',
  'Ward E, DeSantis C, Robbins A, Kohler B, Jemal A. Childhood and adolescent cancer statistics, 2014. CA Cancer J Clin. 2014 Mar-Apr;64(2):83-103. doi: 10.3322/caac.21219. Epub 2014 Jan 31. PMID: 24488779.',
  'Weeks JC, Catalano PJ, Cronin A, Finkelman MD, Mack JW, Keating NL, Schrag D. Patients’ expectations about effects of chemotherapy for advanced cancer. N Engl J Med. 2012 Oct 25;367(17):1616-25. doi: 10.1056/NEJMoa1204410. PMID: 23094723; PMCID: PMC3613151.',
  'Lupo PJ, Spector LG. Cancer Progress and Priorities: Childhood Cancer. Cancer Epidemiol Biomarkers Prev. 2020 Jun;29(6):1081-1094. doi: 10.1158/1055-9965.EPI-19-0941. PMID: 32482635; PMCID: PMC9400945.',
];

const referenceText = (...indices: number[]) => indices.map((index) => `${index + 1}. ${REFERENCES[index]}`).join(' ');

const siteUrl = BUSINESS_DATA.url.replace(/\/$/, '');
const canonicalUrl = `${siteUrl}/`;
const socialImageUrl = `${siteUrl}/og-atavistic-chemotherapy-formal.png`;
const pageTitle = 'Atavistic Chemotherapy | Quimioterapia Atávica';
const pageDescription = 'Información sobre la Quimioterapia Atávica y evaluación de segunda opinión para el ensayo clínico NCT02366884.';
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      name: 'Atavistic Chemotherapy',
      alternateName: 'Quimioterapia Atávica',
      url: canonicalUrl,
      logo: `${siteUrl}/favicon.svg`,
      description: pageDescription,
      contactPoint: {
        '@type': 'ContactPoint',
        telephone: BUSINESS_DATA.contact.phone,
        contactType: 'patient support',
        availableLanguage: ['Spanish', 'English'],
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      name: 'Atavistic Chemotherapy',
      url: canonicalUrl,
      inLanguage: 'es-MX',
      publisher: { '@id': `${siteUrl}/#organization` },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: pageTitle,
      description: pageDescription,
      inLanguage: 'es-MX',
      isPartOf: { '@id': `${siteUrl}/#website` },
      about: {
        '@type': 'MedicalStudy',
        identifier: 'NCT02366884',
        name: 'Atavistic Chemotherapy Clinical Trial',
        url: 'https://clinicaltrials.gov/study/NCT02366884',
      },
      primaryImageOfPage: socialImageUrl,
    },
  ],
};
---
<!DOCTYPE html>

<html lang="es"><head>
<meta charset="utf-8"/>
