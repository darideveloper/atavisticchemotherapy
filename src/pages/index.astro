<div id="lightbox" class="hidden fixed inset-0 z-[100] items-center justify-center bg-black/90 p-4 sm:p-8" role="dialog" aria-modal="true" aria-label="Vista ampliada de imagen">
<button id="lightbox-close" class="absolute top-4 right-4 w-10 h-10 rounded-full bg-white/15 hover:bg-white/30 text-white text-xl font-bold transition" aria-label="Cerrar">×</button>
<figure class="max-w-full flex flex-col items-center gap-3">
