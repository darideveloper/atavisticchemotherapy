---
import '@/styles/global.css'
import { ClientRouter } from 'astro:transitions'
import SiteHeader from '@/components/organisms/SiteHeader.astro'
import SiteFooter from '@/components/organisms/SiteFooter.astro'

const {
	lang = 'en',
	preloadImage,
	preloadSrcSet,
	preloadSizes,
} = Astro.props
---

<!doctype html>
<html lang={lang} class="no-js">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<script is:inline>
			document.documentElement.classList.remove('no-js');
			document.documentElement.classList.add('js');
		</script>
		<link rel="icon" href="/favicon.ico?v=2" sizes="any" />
		<link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
		<meta name="generator" content={Astro.generator} />
		<slot name="seo" />
		{preloadSrcSet
			? <link rel="preload" as="image" imagesrcset={preloadSrcSet} imagesizes={preloadSizes ?? '100vw'} fetchpriority="high" />
			: preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
		<ClientRouter />
	</head>
	<body>
		<SiteHeader lang={lang} />
		<main>
			<slot />
		</main>
		<SiteFooter lang={lang} />
	</body>
</html>
